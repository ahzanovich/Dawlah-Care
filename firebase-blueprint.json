{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role (doctor or patient) and authentication provider details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor"] },
        "provider": { "type": "string", "enum": ["google", "facebook", "demo"] },
        "avatar": { "type": "string" },
        "specialty": { "type": "string" },
        "clinicName": { "type": "string" },
        "licenseNumber": { "type": "string" },
        "consultationFee": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "provider"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Clinical appointment and queue pass record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientAge": { "type": "number" },
        "patientPhone": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "doctorTitle": { "type": "string" },
        "doctorAvatar": { "type": "string" },
        "clinicName": { "type": "string" },
        "clinicAddress": { "type": "string" },
        "consultType": { "type": "string", "enum": ["in-clinic", "house-call", "teleconsult"] },
        "slotTime": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["confirmed", "in-progress", "completed", "cancelled"] },
        "patientSymptoms": { "type": "string" },
        "queueCode": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "patientId", "doctorId", "slotTime", "consultType", "totalAmount", "queueCode"]
    },
    "ReferralCase": {
      "title": "ReferralCase",
      "description": "Inter-doctor consultation and peer clinical case broadcast",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "caseRef": { "type": "string" },
        "patientInitials": { "type": "string" },
        "patientAgeGender": { "type": "string" },
        "symptomsSummary": { "type": "string" },
        "duration": { "type": "string" },
        "primaryConcern": { "type": "string" },
        "referringDoctorId": { "type": "string" },
        "referringDoctorName": { "type": "string" },
        "referringDoctorSpecialty": { "type": "string" },
        "referringClinic": { "type": "string" },
        "targetSpecialty": { "type": "string" },
        "urgency": { "type": "string", "enum": ["routine", "priority", "urgent"] },
        "status": { "type": "string", "enum": ["open", "under-review", "referred", "closed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "caseRef", "referringDoctorId", "targetSpecialty", "urgency", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles for authenticated doctors and patients"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Queue passes and appointment bookings"
    },
    "/referralCases/{caseId}": {
      "schema": "ReferralCase",
      "description": "Broadcast clinical referral cases for physicians"
    }
  }
}
